{
    "inputs": [
        {
            "type": "promptString",
            "id": "github_token",
            "description": "Enter your GitHub Personal Access Token"
        }
    ],
    "servers": {
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
            }
        }
    }
}